@using Microsoft.EntityFrameworkCore

@{
    ViewData["Title"] = "DriverCalendar";
}

@if (TempData["MailTo"] != null)
{
    <a href="mailto:@TempData["MailTo"]?subject=@TempData["MailSubject"]&body=@TempData["MailBody"]"
       class="btn btn-danger mb-3"
       target="_blank">
        Click Here to Send Cancellation Email to Passengers
    </a>
}

<h1>DriverCalendar</h1>


<p>Select a date to create or view your rides</p>

<input type="date" id="rideDate" class="form-control w-25" />
<button onclick="goToDate()" class="btn btn-primary mt-2">Select Date</button>

<div class="mt-4">
    <h5 class="text-success">Your Upcoming Ride Days:</h5>
    @{
        var upcoming = ViewBag.UpcomingRideDates as List<DateTime>;
    }

    @if (upcoming != null && upcoming.Any())
    {
        @foreach (var day in upcoming)
        {
            <a href="/Ride/RidesByDate?date=@day.ToString("yyyy-MM-dd")"
               class="btn btn-success m-1">
                @day.ToString("dd/MM/yyyy")
            </a>
        }
    }
    else
    {
        <p class="text-muted">No upcoming rides</p>
    }
</div>

<script>
    function goToDate(){
        let d = document.getElementById("rideDate").value;
        if (d) window.location.href = "/Ride/RidesByDate?date=" + d;
    }
</script>