@model List<UniShare.Models.Ride>
@{
    ViewData["Title"] = "RidesByDate";
    var selectedDate = ViewBag.SelectedDate;
    // Check is the selected date is today or in the future
    bool canCreateRide = selectedDate >= DateTime.Today;
}

<h1>Rides for @selectedDate.ToString("dd MM yyyy")</h1>
<a asp-action = "DriverCalendar" class="btn btn-secondary mb-3">Back to Calendar</a> 

@if (!Model.Any())
{
    <div class="alert alert-info">No rides found for this day</div>
    if (canCreateRide)
    {
        <a asp-action="CreateRide" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-success">Create a Ride</a>
    }
}
else
{
    foreach(var ride in Model)
    {
        var colorStyle = ride.RideStatus switch
        {
            "Active" => "background-color:#ff9800;color:white",
            "Completed" => "background-color:#9e9e9e;color:white",
            _ => "background-color:#2196f3;color:white"
        };

        <div style="@colorStyle; padding:1em; border-radius:0.5em; margin:0.7em; 0;">
            <h3>@ride.StartLocation → @ride.Destination</h3>
            <p>Time: @ride.RideTime | Seats: @ride.AvailableSeats | €@ride.CostPerSeat</p>
            <p>Status: @ride.RideStatus</p>

            <a asp-action="ViewRide" asp-route-id="@ride.RideId" class="btn btn-light btn-sm">View / Edit</a>

            @if (ride.RideStatus == "Upcoming")
            {
                <a asp-action="StartRide" asp-route-id="@ride.RideId" class="btn btn-warning btn-sm">Ride Started</a>
            }
            @if (ride.RideStatus == "Active")
            {
                <a asp-action="FinishRide" asp-route-id="@ride.RideId" class="btn btn-success btn-sm">Ride Finished</a>
            }
        </div>

    }
    @if (canCreateRide)
    {
        <div class="mt-3">
            <a asp-action="CreateRide" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-success">Create Another Ride</a>
        </div>
    }

}

