<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniShare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UniShare.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @if (Context.Session.GetString("UserId") != null)
                {
                    <a class="navbar-brand" asp-controller="Home" asp-action="Dashboard">UniShare</a>
                }
                else
                {
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">UniShare</a>
                }
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @if (Context.Session.GetString("UserRole") == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }

                        @if (Context.Session.GetString("UserRole") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="MyProfile">My Profile</a>
                            </li>

                            @if (Context.Session.GetString("UserRole") == "Driver")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Ride" asp-action="DriverCalendar">Driver Calendar</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Request" asp-action="AllRequestsReceived">Requests Received</a>
                                </li>
                            }

                            @if (Context.Session.GetString("UserRole") == "Passenger")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Request" asp-action="PublicRideBoard">Public Ride Board</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Request" asp-action="MySentRequests">My Requests</a>
                                </li>
                            }

                            @if (Context.Session.GetString("UserRole") == "Admin")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">Admin Panel</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="SystemOverview">System Overview</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="UserManagement">Manage Users</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="RideManagement">Manage Rides</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="ReportsFlags">Reports & Flags</a></li>
                                    </ul>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @inject UniShare.Data.UniShareDbContext DbContext

    @{
        bool isSuspended = false;
        int? userId = Context.Session.GetInt32("UserId");

        if (userId.HasValue)
        {
            var user = DbContext.Users.Find(userId.Value);
            if (user != null)
            {
                isSuspended = user.AccountStatus == "Suspended";
            }
        }
    }

    @if (isSuspended)
    {
        <div class="alert alert-danger text-center p-3 m-0 rounded-0">
            <h4>⚠ ACCOUNT SUSPENDED ⚠</h4>
            <p class="mb-0">You cannot use any ride features. Please contact the administrator.</p>
        </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - UniShare 
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>