
@{
    ViewData["Title"] = "Dashboard";
}




<h1>Welcome, @ViewBag.UserName</h1>

<p class="lead" style="max-width: 768px; margin: 2rem auto;">Your Role: <strong>@ViewBag.UserRole</strong></p>

@if(ViewBag.UserRole == "Driver")
{
    <div class="card p-5" style="max-width: 768px; margin: 2rem auto;">
        <h4>Driver Dashboard</h4>
        <p>Manage your rides, calendar and incoming requests.</p>
        <a asp-action="DriverCalendar" asp-controller="Ride" class="btn btn-primary">Open Calendar</a>
        <a asp-action="AllRequestsReceived" asp-controller="Request" class="btn btn-success">View Requests</a>
    </div>
    <div class="card p-3 mb-3" style="max-width: 768px; margin: 2rem auto;">
        <h5>🚙 Today's Rides (Active + Upcoming)</h5>
        @{
            var todayRides = ViewBag.TodayRides as List<UniShare.Models.Ride>;
        }
        @if (todayRides != null && todayRides.Any())
        {
            @foreach (var ride in todayRides)
            {
                <div class="border p-2 mb-2 rounded">
                    <p class="mb-1"><strong>Route:</strong> @ride.StartLocation → @ride.Destination</p>
                    <p class="mb-1"><strong>Time:</strong> @ride.RideTime</p>
                    <p class="mb-1">
                        <strong>Status:</strong>
                        @if (ride.RideStatus == "Active")
                        {
                            <span class="badge bg-primary">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Upcoming</span>
                        }
                    </p>
                    @if (ride.RideStatus == "Upcoming")
                    {
                        DateTime scheduled = ride.RideDate.Date+ride.RideTime;
                        DateTime now = DateTime.UtcNow.AddHours(1);

                        if (now >= scheduled.AddMinutes(-30) && now <= scheduled.AddHours(2))
                        {

                            <a asp-action="StartRide" asp-controller = "Ride" asp-route-id="@ride.RideId" class="btn btn-warning btn-sm" onclick="return confirm('Start this ride?')">Ride Started</a>
                        }
                        else if (now < scheduled.AddMinutes(-30))
                        {
                            <p class="text-warning">
                                🕒 Ride not ready yet. You can start 30 minutes before scheduled time.
                            </p>
                        }
                    }
                    @if (ride.RideStatus == "Active")
                    {
                        <a asp-action="FinishRide" asp-controller = "Ride"  asp-route-id="@ride.RideId" class="btn btn-success btn-sm">Ride Finished</a>
                    }
                </div>


            }
        }
        else
        {
            <p class="text-muted mb-0">No active or upcoming rides today!</p>
        }
    </div>
}

@if (ViewBag.UserRole == "Passenger")
{
    <div class="card p-5" style="max-width: 768px; margin: 2rem auto;">
        <h4>Passenger Dashboard</h4>
        <p>Find rides and manage your join requests.</p>
        <a asp-action="PublicRideBoard" asp-controller="Request" class="btn btn-primary">Browse Rides</a>
        <a asp-action="MySentRequests" asp-controller="Request" class="btn btn-success">My Requests</a>
    </div>

    <div class="card p-3 mb-3 " style="max-width: 768px; margin: 2rem auto;">
        <h5 class="text-success">🚙 Your Upcoming Ride Requests</h5>
        @{
            var futureReqs = ViewBag.FutureRequests as List<UniShare.Models.RideRequest>;
        }
        @if (futureReqs != null && futureReqs.Any())
        {
            @foreach (var req in futureReqs)
            {
                <div class="border p-2 mb-2 rounded">
                    <p class="mb-1"><strong>Route:</strong> @req.Ride.StartLocation → @req.Ride.Destination</p>
                    <p class="mb-1"><strong>Date:</strong> @req.Ride.RideDate.ToString("dd/MM/yyyy")</p>
                    <p class="mb-1"><strong>Time:</strong> @req.Ride.RideTime</p>
                    <p class="mb-1"><strong>Driver:</strong> @req.Driver.UserName</p>
                    <p class="mb-1">
                        <strong>Request Status:</strong>
                        @if (req.RequestStatus == "Accepted")
                        {
                            <span class="badge bg-success">Accepted</span>
                        }
                        else if (req.RequestStatus == "New")
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else
                        {
                            <span>@req.RequestStatus</span>
                        }
                    </p>
                </div>
            }
        }
        else
        {
            <p class="text-muted mb-0">No upcoming ride requests.</p>
        }
    </div>
}
@if (ViewBag.UserRole == "Admin")
{
    <div class="card p-5" style="max-width: 768px; margin: 2rem auto;">
        <h4>Admin Dashboard</h4>
        <p>Monitor system, users, rides and reports.</p>
        <a asp-action="SystemOverview" asp-controller="Admin" class="btn btn-primary">System Overview</a>
        <a asp-action="UserManagement" asp-controller="Admin" class="btn btn-secondary">Manage Users</a>
    </div>
}