@model List<UniShare.Models.Report>
@{
    ViewData["Title"] = "ReportsFlags";
}

<h1>Reports & Flags</h1>
<div style="max-width: 768px; margin: 2rem auto">

    <form method="get" class="mb-3">
        <input name="search" class="form-control w-50" placeholder="Search report ID / ride ID / reason" value="@ViewBag.Search">
        <button class="btn btn-primary mt-2">Search</button>
    </form>

    @foreach (var r in Model)
    {
        <div class="card p-3 mb-3 @(r.ReportStatus == "Resolved" ? "bg-light text-muted" : "")">
            <h5>Priority: @r.Priority</h5>
            <p><strong>Report ID:</strong> @r.ReportId</p>
            <p><strong>Ride ID:</strong> @r.RelatedRideId</p>
            <p><strong>Reason:</strong> @r.ReportReason</p>
            <p><strong>Status:</strong> @r.ReportStatus</p>
            <p><strong>Time:</strong> @r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    }
</div>
