@model UniShare.Models.User
@{
    ViewData["Title"] = "Register";
}

<h1>Create Account</h1>

<div style="max-width: 450px; margin: 0 auto;">
    <form method="post">
        <label asp-for="UserName" class="form-label">Name</label>
        <input asp-for="UserName" required class="form-control mb-2" />
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" type="email" required class="form-control mb-2" />
        <label asp-for="PasswordHash" class="form-label">Password</label>
        <input asp-for="PasswordHash" type="password" required class="form-control mb-2" />
        <label asp-for="Role" class="form-label">Select a Role</label>
        <select asp-for="Role" class="form-control mb-2">
            <option value="Passenger">Passenger</option>
            <option value="Driver">Driver</option>
@*                     <option value="Admin">Admin</option>
 *@    </select>
        <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
        <input asp-for="PhoneNumber" class="form-control mb-2" />
        <div class="text-danger mb-2">
            <span asp-validation-for="PhoneNumber"></span>
        </div>        
        <label asp-for="HomeAddress" class="form-label">Address</label>
        <input asp-for="HomeAddress" required class="form-control mb-2">
        <button class="btn btn-success">Register</button>
    </form>

</div>

