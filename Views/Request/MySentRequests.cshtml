@model List<UniShare.Models.RideRequest>
@{
    ViewData["Title"] = "MySentRequests";
}

<h1>My Sent Requests</h1>

<div style="max-width: 968px; margin: 2rem auto;">

    <h3 style="color:orange">Pending Requests</h3>
    @foreach (var item in Model.Where(r => r.RequestStatus == "New"))
    {
        <div class="border p-3 mb-2 rounded">
            <p>Ride: @item.Ride.StartLocation → @item.Ride.Destination</p>
            <p>Date: @item.Ride.RideDate.ToString("dd/MM/yyyy")</p>
            <p>Time: @item.Ride.RideTime</p>
            <p>Status: <span class="text-success">@item.RequestStatus</span></p>
            <a asp-action="CancelSentRequest" asp-route-id="@item.RequestId" class="btn btn-danger btn-sm">Cancel Request</a>
            <a href="mailto:@item.Driver.Email" class="btn btn-info btn-sm">Message Driver</a>
        </div>
    }

    <h3 style="color:green">Accepted Requests</h3>
    @foreach (var item in Model.Where(r => r.RequestStatus == "Accepted"))
    {
        <div class="border p-3 mb-2 rounded">
            <p>Ride: @item.Ride.StartLocation → @item.Ride.Destination</p>
            <p>Date: @item.Ride.RideDate.ToString("dd/MM/yyyy")</p>
            <p>Time: @item.Ride.RideTime</p>
            <p><strong>Driver Name:</strong> @item.Driver.UserName</p>
            <p><strong>Driver Contact:</strong> @item.Driver.PhoneNumber</p>
            <p>Status: <span class="text-success">@item.RequestStatus</span></p>
            <a href="mailto:@item.Driver.Email" class="btn btn-info btn-sm">Message Driver</a>
            <small class="text-muted">Contact driver to cancel</small>
            <form asp-action="ReportRide" asp-controller="Request" method="post" class="mt-2" onsubmit="return confirm('Submit this report?');">
                <input type="hidden" name="rideId" value="@item.RideId" />

                <select name="reportReason" class="form-select form-select-sm mb-1" required>
                    <option value="">Select a reason</option>
                    <option value="No-show / Didn’t arrive">No-show / Didn’t arrive </option>
                    <option value="Rude/aggressive behavior">Rude/aggressive behavior </option>
                    <option value="Unsafe/inappropriate behavior">Unsafe/inappropriate behavior </option>
                    <option value="Late without notice">Late without notice </option>
                    <option value="Poor communication">Poor communication </option>
                    <option value="Changed plans last minute">Changed plans last minute </option>
                    <option value="Uncomfortable experience">Uncomfortable experience </option>
                    <option value="Other">Other (describe below)</option>
                </select>

                <textarea name="customReason" class="form-control form-control-sm mb-1" placeholder="Only type here if you selected 'Other'"></textarea>
                <button class="btn btn-danger btn-sm w-100">Report This Ride</button>
            </form>
        </div>
    }

    <h3 style="color:grey">Completed / Cancelled Requests</h3>
    @foreach (var item in Model.Where(r => r.RequestStatus != "New" && r.RequestStatus != "Accepted"))
    {
        <div class="border p-3 mb-2 rounded text-muted">
            <p>Ride: @item.Ride.StartLocation → @item.Ride.Destination</p>
            <p>Date: @item.Ride.RideDate.ToString("dd/MM/yyyy")</p>
            <p>Time: @item.Ride.RideTime</p>
            @if (item.RequestStatus == "CancelledByDriver")
            {
                <p class="text-danger fw-bold">
                    🔔 Driver CANCELLED this accepted ride
                </p>
            }
            @if (item.RequestStatus == "RideExpired")
            {
                <p class="text-danger fw-bold">
                    🔔 THIS RIDE HAS EXPIRED
                </p>
            }
            <p>Status: <span class="text-success">@item.RequestStatus</span></p>
            <small>No actions available</small>
        </div>
    }

</div>



