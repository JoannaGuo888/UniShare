@model IEnumerable<UniShare.Models.RideRequest>

@{
    ViewData["Title"] = "AllRequestsReceived";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["MailTo"] != null)
{
    <a href="mailto:@TempData["MailTo"]?subject=@TempData["MailSubject"]&body=@TempData["MailBody"]"
       class="btn btn-danger mb-3"
       target="_blank">
        Click Here to Send Cancellation Email to Passenger
    </a>
}
<h1>All Requests Received</h1>

<h3 style="color:orange">New Pending Requests</h3>
@foreach(var item in Model.Where(r=>r.RequestStatus == "New"))
{
    <div style="border: 0.2em solid orange; padding: 1em; border-radius:0.5em; margin-bottom:0.6em;">
        <p><strong>Ride:</strong> @item.Ride.StartLocation → @item.Ride.Destination</p>
        <p><strong>Ride Date:</strong> @item.Ride.RideDate.ToString("dd/MM/yyyy")</p>
        <p><strong>Time:</strong> @item.Ride.RideTime</p>
        <p><strong>Passenger:</strong> @item.Passenger.UserName</p>
        <p><strong>Message:</strong> @item.Message</p>
        <p><strong>Status:</strong> <span style="color:orange">@item.RequestStatus</span></p>

        <a asp-action="AcceptRequest" asp-route-id="@item.RequestId" class="btn btn-success btn-sm">Accept</a>
        <a asp-action="DeclineRequest" asp-route-id="@item.RequestId" class="btn btn-danger btn-sm">Decline</a>
        <a href="mailto:@item.Passenger.Email" class="btn btn-info btn-sm">Message Sender</a>
    </div>
}

<h3 style="color:green">Accepted Requests</h3>
@foreach(var item in Model.Where(r=> r.RequestStatus == "Accepted"))
{
    <div style="border:0.2em solid green; padding:1em; border-radius:0.5em; margin-bottom:0.6em;">
        <p><strong>Ride:</strong> @item.Ride.StartLocation → @item.Ride.Destination</p>
        <p><strong>Ride Date:</strong> @item.Ride.RideDate.ToString("dd/MM/yyyy")</p>
        <p><strong>Time:</strong> @item.Ride.RideTime</p>
        <p><strong>Passenger:</strong> @item.Passenger.UserName</p>
        <p><strong>Passenger Contact:</strong> @item.Passenger.PhoneNumber</p>
        <p><strong>Status:</strong> <span style="color:green">@item.RequestStatus</span></p>

        <a href="mailto:@item.Passenger.Email" class="btn btn-info btn-sm">Message Sender</a>        
        <a asp-action="CancelAcceptedRequest" asp-route-id="@item.RequestId" class="btn btn-warning btn-sm">Cancel</a>
    </div>
}

<h3 style="color:grey">Completed & Cancelled Requests</h3>
@foreach(var item in Model.Where(r=>r.RequestStatus!="New" && r.RequestStatus != "Accepted"))
{
    <div style="border:0.2em solid grey; padding: 1em; border-radius: 0.5em; margin-bottom: 0.6em; color: grey;">
        <p><strong>Ride:</strong> @item.Ride.StartLocation → @item.Ride.Destination</p>
        <p><strong>Ride Date:</strong> @item.Ride.RideDate.ToString("dd/MM/yyyy")</p>
        <p><strong>Time:</strong> @item.Ride.RideTime</p>
        <p><strong>Passenger:</strong> @item.Passenger.UserName</p>
        <p><strong>Status:</strong> @item.RequestStatus</p>
        <small>No actions available</small>
    </div>
}

